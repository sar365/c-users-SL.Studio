<Window x:Class="SLSTUDIO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SL.STUDIO — Record What You Hear"
        Height="540"
        Width="640"
        MinWidth="520"
        MinHeight="480"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource AppForeground}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource AppBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <!-- Mirrored SL Brand Box -->
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppPrimary}" BorderThickness="1.5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="S" FontWeight="Black" FontSize="16" Foreground="{StaticResource AppPrimary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="L" FontWeight="Black" FontSize="16" Foreground="{StaticResource AppPrimary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="S" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource AppPrimary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="L" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource AppPrimary}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="." FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource AppPrimary}" />
                            <TextBlock Text="STUDIO" FontWeight="ExtraBold" FontSize="18" Foreground="{StaticResource AppForeground}" />
                        </StackPanel>
                        <TextBlock Text="Record What You Hear • WASAPI Loopback / ASIO" FontSize="11" Foreground="{StaticResource AppMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Right" CornerRadius="12" Background="#1a1fb5a2" BorderBrush="#331fb5a2" BorderThickness="1" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AppPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="CORE AUDIO NATIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppPrimary}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Source Endpoint Card -->
        <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" HorizontalAlignment="Right" Background="#141fb5a2" BorderBrush="{StaticResource AppPrimary}" BorderThickness="1" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="SourceBadgeText" Text="WASAPI LOOPBACK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppPrimary}" />
                </Border>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RECORDING SOURCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="SourceComboBox" SelectionChanged="OnSourceSelectionChanged" Margin="14,0,0,0" Height="28" HorizontalAlignment="Left" Width="220">
                        <ComboBoxItem Content="WASAPI loopback (default)" Tag="Wasapi" IsSelected="True" />
                        <ComboBoxItem Content="ASIO input" Tag="Asio" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ASIO DRIVER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="AsioDriverComboBox" SelectionChanged="OnAsioDriverSelectionChanged" Margin="14,0,0,0" Height="28" HorizontalAlignment="Left" Width="360" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="EndpointLabelText" Text="ACTIVE WINDOWS PLAYBACK ENDPOINT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppMuted}" />
                    <TextBlock x:Name="DeviceNameText" Text="Resolving default audio output..." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppForeground}" Margin="0,4,0,2" />
                    <TextBlock x:Name="FormatText" Text="Detecting mix format (PCM 44.1/48kHz)..." FontSize="11" Foreground="{StaticResource AppMuted}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Peak Meters -->
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="16" Padding="16,14">
            <StackPanel>
                <!-- Left Channel -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="L" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" x:Name="MeterLeft" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource AppBorder}" Foreground="{StaticResource AppPrimary}" BorderThickness="0" />
                    <TextBlock Grid.Column="2" x:Name="MeterLeftText" Text="−∞" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AppMuted}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Right Channel -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="R" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppMuted}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" x:Name="MeterRight" Height="8" Minimum="0" Maximum="100" Value="0" Background="{StaticResource AppBorder}" Foreground="{StaticResource AppPrimary}" BorderThickness="0" />
                    <TextBlock Grid.Column="2" x:Name="MeterRightText" Text="−∞" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource AppMuted}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Big Timer & Record Button Hero -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource AppElevated}" BorderBrush="{StaticResource AppBorder}" BorderThickness="1" CornerRadius="20" Padding="20">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TimerText" Text="00:00:00" FontSize="44" FontFamily="Consolas, Segoe UI" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBlock Grid.Row="1" x:Name="BytesWrittenText" Text="Ready to record" FontSize="12" Foreground="{StaticResource AppMuted}" HorizontalAlignment="Center" Margin="0,4,0,0" />

                <!-- Action Button -->
                <Button Grid.Row="2" x:Name="RecordToggleButton" Click="OnRecordToggleClicked" Margin="0,20,0,0" Height="52" Background="{StaticResource AppPrimary}" Foreground="#051a16" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14" />
                        </Style>
                    </Button.Resources>
                    <TextBlock x:Name="ButtonLabel" Text="START RECORDING" />
                </Button>

                <!-- Output folder quick link -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Saving directly to: " FontSize="11" Foreground="{StaticResource AppMuted}" />
                    <TextBlock x:Name="FolderLinkText" Text="Music\SL.STUDIO Sets" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppPrimary}" Cursor="Hand" MouseDown="OnOpenFolderClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="4,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="StatusText" Text="Ready." FontSize="11" Foreground="{StaticResource AppMuted}" />
                <TextBlock DockPanel.Dock="Right" Text="SL.STUDIO Phase 1" FontSize="11" Foreground="{StaticResource AppMuted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>